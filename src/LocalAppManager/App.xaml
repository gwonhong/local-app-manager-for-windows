<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LocalAppManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LogTimestampBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="LogSourceBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="LogSystemBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="LogErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="LogSearchHighlightBrush" Color="#FFE58F" />
                    <SolidColorBrush x:Key="LogSearchHighlightTextBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="StateStoppedBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="StateStartingBrush" Color="#C27C00" />
                    <SolidColorBrush x:Key="StateRunningBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="StateExitedBrush" Color="#5C6BC0" />
                    <SolidColorBrush x:Key="StateCrashedBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LogTimestampBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="LogSourceBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="LogSystemBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="LogSearchHighlightBrush" Color="#C9A227" />
                    <SolidColorBrush x:Key="LogSearchHighlightTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="StateStoppedBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="StateStartingBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="StateRunningBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="StateExitedBrush" Color="#9AA5FF" />
                    <SolidColorBrush x:Key="StateCrashedBrush" Color="#FF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LogTimestampBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="LogSourceBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="LogSystemBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="LogErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LogSearchHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LogSearchHighlightTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StateStoppedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="StateStartingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateRunningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StateExitedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StateCrashedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="LogFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
            <!-- Explicit Latin font so "\" in paths isn't drawn as "₩" by the Korean UI font. -->
            <FontFamily x:Key="PathFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>

            <!-- Small toolbar button with only an icon. -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
